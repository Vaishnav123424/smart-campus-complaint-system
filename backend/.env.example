PORT=5000
NODE_ENV=development
# MongoDB URI - either local MongoDB or MongoDB Atlas connection string
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/mitaoe_smart_campus?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/mitaoe_smart_campus
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173
